<UserControl x:Class="Wally.App.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="28" Height="28">
    <!-- wally brand mark: a solid white rounded-square tile with a monitor
         showing a wallpaper inside it. The tile is the accent (white) fill; the
         monitor frame and stand are punched to the app background, and the screen
         holds a simple wallpaper motif (horizon + sun). 28x28 canvas, scales
         crisply via the parent's Width/Height. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="28" Height="28">
            <!-- White rounded-square tile -->
            <Border CornerRadius="7" Background="{DynamicResource Accent}" />

            <Canvas Width="28" Height="28">
                <!-- Monitor screen frame (dark outline on the white tile) -->
                <Border Canvas.Left="8" Canvas.Top="8" Width="12" Height="8.5"
                        CornerRadius="1.5"
                        Background="{DynamicResource Accent}"
                        BorderBrush="{DynamicResource AppBackground}"
                        BorderThickness="1.6">
                    <!-- Wallpaper motif inside the screen, clipped to the frame -->
                    <Grid ClipToBounds="True">
                        <!-- Sun -->
                        <Ellipse Width="2.6" Height="2.6"
                                 Fill="{DynamicResource AppBackground}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="1,0.6,0,0" />
                        <!-- Hill / horizon -->
                        <Path Fill="{DynamicResource AppBackground}"
                              Data="M -2,7 Q 3,3 6,5 Q 8,6 12,3 L 12,9 L -2,9 Z"
                              VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <!-- Monitor stand -->
                <Rectangle Canvas.Left="13.2" Canvas.Top="16.5" Width="1.6" Height="2"
                           Fill="{DynamicResource AppBackground}" />
                <Rectangle Canvas.Left="11" Canvas.Top="18" Width="6" Height="1.6"
                           RadiusX="0.8" RadiusY="0.8"
                           Fill="{DynamicResource AppBackground}" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
