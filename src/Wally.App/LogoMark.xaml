<UserControl x:Class="Wally.App.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="28" Height="28">
    <!-- Structured like the picky icon: a solid white rounded-square tile with a
         mark inside it. The tile is the accent (white) fill; the viewfinder glyph
         is punched through to the app background. Drawn on a 28x28 canvas, scales
         crisply via the parent's Width/Height. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="28" Height="28">
            <!-- White rounded-square tile -->
            <Border CornerRadius="7" Background="{DynamicResource Accent}" />

            <!-- Dark viewfinder glyph inside the tile -->
            <Canvas Width="28" Height="28">
                <!-- Corner brackets (dark, on the white tile) -->
                <Path Stroke="{DynamicResource AppBackground}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M8,11 L8,8 L11,8" />
                <Path Stroke="{DynamicResource AppBackground}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M17,8 L20,8 L20,11" />
                <Path Stroke="{DynamicResource AppBackground}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M20,17 L20,20 L17,20" />
                <Path Stroke="{DynamicResource AppBackground}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M11,20 L8,20 L8,17" />
                <!-- Centred square -->
                <Rectangle Canvas.Left="12" Canvas.Top="12" Width="4" Height="4"
                           RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource AppBackground}" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
