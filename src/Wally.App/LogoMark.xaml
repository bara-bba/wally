<UserControl x:Class="Wally.App.LogoMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="28" Height="28">
    <!-- wally brand mark: a solid white rounded-square tile with a monitor
         showing a wallpaper inside it. The tile is the accent (white) fill; the
         monitor frame and stand are punched to the app background, and the screen
         holds a simple wallpaper motif (horizon + sun). 28x28 canvas, scales
         crisply via the parent's Width/Height. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="28" Height="28">
            <!-- White rounded-square tile -->
            <Border CornerRadius="7" Background="{DynamicResource Accent}" />

            <Canvas Width="28" Height="28">
                <!-- Monitor screen frame (dark outline on the white tile) -->
                <Border Canvas.Left="6" Canvas.Top="7" Width="16" Height="11"
                        CornerRadius="1.5"
                        Background="{DynamicResource Accent}"
                        BorderBrush="{DynamicResource AppBackground}"
                        BorderThickness="2">
                    <!-- Wallpaper motif inside the screen, clipped to the frame -->
                    <Grid ClipToBounds="True">
                        <!-- Sun -->
                        <Ellipse Width="4" Height="4"
                                 Fill="{DynamicResource AppBackground}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="1.5,0.5,0,0" />
                        <!-- Hill / horizon -->
                        <Path Fill="{DynamicResource AppBackground}"
                              Data="M -2,9 Q 4,3 8,6 Q 11,8 16,4 L 16,11 L -2,11 Z"
                              VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <!-- Monitor stand -->
                <Rectangle Canvas.Left="13" Canvas.Top="18" Width="2" Height="2.5"
                           Fill="{DynamicResource AppBackground}" />
                <Rectangle Canvas.Left="10" Canvas.Top="20" Width="8" Height="2"
                           RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource AppBackground}" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
