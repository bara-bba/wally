<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Wally.Core\Wally.Core.csproj" />
    <ProjectReference Include="..\Wally.Platform\Wally.Platform.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Wally</AssemblyName>
  </PropertyGroup>

  <!-- Distribution: self-contained single-file exe. Users need nothing
       preinstalled (the .NET 8 runtime is bundled). Produced via build-dist.ps1
       or: dotnet publish -c Release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <Version>0.1.0</Version>
    <Company>wally</Company>
    <Product>wally</Product>
    <AssemblyTitle>wally</AssemblyTitle>
  </PropertyGroup>

</Project>
